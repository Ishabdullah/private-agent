<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.SET_ALARM" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission
        android:name="android.permission.SYSTEM_ALERT_WINDOW"
        tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- For speech recognition -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="sms" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="mailto" />
        </intent>
    </queries>

    <application
        android:label="PrivateAgent"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Phase 9: required for AssistantInteractionSession's
                 startVoiceActivity() handoff to succeed. Android's
                 ActivityStarter (server-side) rejects any activity start
                 from a brand-new voice session with
                 START_NOT_VOICE_COMPATIBLE unless the target activity
                 declares an intent-filter matching the intent, including
                 CATEGORY_VOICE (which startVoiceActivity always adds
                 automatically), even though the intent already names
                 MainActivity explicitly by component. Confirmed against
                 AOSP's ActivityStarter.java (the exact SecurityException
                 message "Starting under voice control not allowed for"
                 traces to this check) after reproducing the crash via adb
                 logcat on a real device. -->
            <intent-filter>
                <action android:name="com.orailnoor.privateagent.action.ASSISTANT_INTERACTION"/>
                <category android:name="android.intent.category.VOICE"/>
            </intent-filter>
        </activity>

        <!-- Phase 5a: foreground-service shell for always-on wake-word
             listening. No audio/wake-word engine wired in yet. -->
        <service
            android:name=".VoiceAssistantForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Phase 9 (optional/additive): lets PrivateAgent be selected as
             the system's Digital Assistant app, so long-press-home / the
             assistant gesture routes here. Not required for the core
             wake-word/mic-button voice flow, which works without any of
             this; see plan doc Section 10.3. -->
        <service
            android:name=".AssistantInteractionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/interaction_service" />
        </service>

        <service
            android:name=".AssistantInteractionSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />

        <!-- Mandatory companion of AssistantInteractionService (see
             AssistantPassthroughRecognitionService.kt); not used by this
             app's own voice pipeline. -->
        <service
            android:name=".AssistantPassthroughRecognitionService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.speech"
                android:resource="@xml/recognition_service" />
        </service>

        <receiver android:name=".BackgroundEngineReceiver" android:exported="true">
            <intent-filter>
                <action android:name="com.orailnoor.privateagent.REGISTER_BACKGROUND_CHANNELS" />
            </intent-filter>
        </receiver>

        <!-- Provide required meta-data for flutter -->

        <!-- Shizuku provider (optional - only works when Shizuku is installed) -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- Accessibility Service for screen reading and UI automation -->
        <service
            android:name=".AgentAccessibilityService"
            android:exported="true"
            android:label="PrivateAgent Screen Control"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>
